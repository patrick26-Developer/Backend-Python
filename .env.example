# ============================================================================
#  taskman - Exemple de configuration / Configuration example
# ----------------------------------------------------------------------------
#  Copier ce fichier en `.env` et adapter les valeurs.
#  Copy this file to `.env` and adjust the values.
#  `.env` est ignoré par git : aucun secret ne doit être committé.
#  `.env` is git-ignored: never commit real secrets.
# ============================================================================

# Toutes les variables de l'app sont préfixées APP_ (voir taskman/core/config.py).

# Environnement d'exécution : local | test | staging | production
APP_ENV=local

# Nom de l'application (exposé dans /docs et les logs)
APP_NAME=taskman

# Serveur (utilisé par `fastapi run` / uvicorn)
APP_HOST=127.0.0.1
APP_PORT=8000

# Niveau de log : DEBUG | INFO | WARNING | ERROR
APP_LOG_LEVEL=INFO

# --- Module 04 : base de données ---
# Dev (défaut) : SQLite local. Prod : PostgreSQL via asyncpg.
APP_DATABASE_URL=sqlite+aiosqlite:///./taskman.db
# APP_DATABASE_URL=postgresql+asyncpg://taskman:taskman@localhost:5432/taskman
APP_DB_ECHO=false

# --- Module 08 : cache & tâches de fond ---
# Sans URL : cache en mémoire + broker in-process. Avec : Redis partagé + workers.
# APP_REDIS_URL=redis://localhost:6379/0

# --- Module 09 : observabilité ---
APP_OTEL_ENABLED=false
# APP_OTEL_ENDPOINT=http://localhost:4318   # collector OTLP ; sinon exporteur console

# --- Module 06 : authentification ---
# OBLIGATOIRE hors dev (openssl rand -hex 32). L'app refuse de démarrer sinon en prod.
APP_JWT_SECRET_KEY=dev-only-not-secret-change-me-with-openssl-rand-hex-32
APP_JWT_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=15
APP_REFRESH_TOKEN_EXPIRE_DAYS=7
