# ============================================================================
#  taskman - Exemple de configuration / Configuration example
# ----------------------------------------------------------------------------
#  Copier ce fichier en `.env` et adapter les valeurs.
#  Copy this file to `.env` and adjust the values.
#  `.env` est ignoré par git : aucun secret ne doit être committé.
#  `.env` is git-ignored: never commit real secrets.
# ============================================================================

# Environnement d'exécution : local | test | staging | production
APP_ENV=local

# Nom et version de l'application (exposés dans /docs et les logs)
APP_NAME=taskman
APP_VERSION=0.1.0

# Serveur
APP_HOST=127.0.0.1
APP_PORT=8000

# Niveau de log : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Utilisés à partir du Module 04 (base de données) ---
# DATABASE_URL=postgresql+asyncpg://taskman:taskman@localhost:5432/taskman

# --- Utilisés à partir du Module 06 (authentification) ---
# JWT_SECRET_KEY=change-me-with-openssl-rand-hex-32
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=7
